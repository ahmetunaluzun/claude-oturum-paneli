<Project Sdk="Microsoft.NET.Sdk">
  <!-- Testler için sahte claude.exe (tools/mail_ozet_test.sh): .cmd sahtesi satır içi JSON argümanını (settings) taşıyamıyor.
       Argümanları SAHTE_CLAUDE_ARGS dosyasına satır satır yazar, sonra tools/sahte_claude.py'yi aynı stdin/stdout ile çalıştırır. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>claude</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
